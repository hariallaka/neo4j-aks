# Copy to terraform.tfvars and adjust, or pass equivalent -var/-var-file/
# TF_VAR_* at apply time.

azure_subscription_id = null # or "00000000-0000-0000-0000-000000000000"
entra_tenant_id       = "11111111-2222-3333-4444-555555555555"

resource_group_name = "rg-neo4j-aks"
location            = "eastus"
cluster_name        = "neo4j-aks"
dns_prefix          = "neo4j-aks"
kubernetes_version  = null # leave null for AKS's current default
node_count          = 3
node_vm_size        = "Standard_D4s_v5"

local_account_disabled     = false
aks_admin_group_object_ids = [] # e.g. ["66666666-7777-8888-9999-000000000000"]
aks_authorized_ip_ranges   = [] # e.g. ["203.0.113.0/24"]
enable_microsoft_defender  = true

small_pool_vm_size    = "Standard_D4s_v5"
small_pool_node_count = 2
large_pool_vm_size    = "Standard_D8s_v5"
large_pool_node_count = 2

key_vault_name            = "kv-neo4j-aks"
key_vault_admin_object_id = null

neo4j_namespace                = "neo4j"
neo4j_release_name             = "neo4j-aks"
neo4j_edition                  = "enterprise"
neo4j_accept_license_agreement = "yes" # or "eval" for evaluation use
neo4j_cpu                      = "1000m"
neo4j_memory                   = "2Gi"
neo4j_storage_class            = "managed-csi"
neo4j_data_disk_size_gb        = 50
neo4j_node_pool_tier           = "small"

# Number of Neo4j cluster members (Helm releases/pods) for HA. 1 = standalone
# (default -- matches a single-instance license). 3+ requires enterprise +
# a valid license -- see README's HA/licensing section before turning this
# up if your license is scoped to a single instance.
neo4j_cluster_size = 1

# "helm_release" (default) uses Terraform's native helm provider.
# "helm_cli" instead shells out to a local `helm` binary via null_resource
# -- see README's proxy-cache note if helm.neo4j.com isn't reachable from
# your network and you're pointing neo4j_helm_repo_url at an internal mirror.
neo4j_deployment_method  = "helm_release"
neo4j_helm_repo_url      = "https://helm.neo4j.com/neo4j"
neo4j_helm_chart_version = "" # e.g. "2026.6.0" to pin; "" = latest

# Leave "" until the one-time Entra app registration in README.md is done.
neo4j_oidc_client_id = ""

# Opt-in, and only after OIDC above is working: drops native (password)
# auth entirely, leaving only Entra SSO. Requires the one-time bootstrap +
# rollout sequence in README's "OIDC-only authentication" section --
# flipping this straight to true without that first locks everyone out,
# including this stack's own admin password, with no fallback.
neo4j_disable_native_auth = false

# Only needed once neo4j_disable_native_auth = true: the onboarding
# pipeline's OWN Entra app registration/service principal's client secret
# (distinct from neo4j_oidc_client_id -- see README). Leave "" to manage
# this secret entirely outside Terraform instead.
neo4j_pipeline_client_secret = ""

# Opt-in: front Neo4j with the cluster's existing Istio ingress gateway --
# a Gateway + VirtualService doing plain TCP passthrough to services.neo4j
# (Bolt 7687 + Browser HTTP 7474). Assumes Istio is already installed/
# managed in this cluster outside this stack -- see README's Istio section
# before enabling.
neo4j_istio_gateway_enabled = false
istio_ingress_gateway_selector = {
  istio = "ingressgateway" # match your existing Istio ingress gateway's pod labels
}
